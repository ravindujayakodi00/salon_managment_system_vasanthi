{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/queues/campaign-delivery/route.ts": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "campaign-delivery",
          "retryAfterSeconds": 10,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/birthday-messages",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/test-birthday-message",
      "schedule": "0 19 * * *"
    }
  ]
}
